{
    "name": "mgamadeus/ddd-design-studio",
    "description": "Design review studio for mgamadeus/ddd — shows the design boards of a checkout on a canvas, with comments, statuses, decisions and optional thumbnails",
    "minimum-stability": "stable",
    "license": "MIT",
    "homepage": "https://github.com/ddd-framework/ddd-design-studio",
    "support": {
        "issues": "https://github.com/ddd-framework/ddd-design-studio/issues",
        "source": "https://github.com/ddd-framework/ddd-design-studio"
    },
    "version": "0.2.3",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd": "^3.15.3",
        "mgamadeus/ddd-argus": "^1.3.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\DesignStudio\\": "tests/"
        }
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\DesignStudio\\DesignStudioModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    }
}
